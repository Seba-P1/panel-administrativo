# Copiar a .env solo si no usas npm run init. Nunca subir .env a Git.
PORT=3001
HOST=127.0.0.1
APP_URL=http://localhost:3001
# NODE_ENV lo fija Docker en produccion; dejar sin definir para el modo local.
DATA_DIR=./data
SETUP_TOKEN=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_64_CARACTERES
TRUST_PROXY=0
# Servidor: APP_URL=https://panel.tu-dominio.com y PANEL_DOMAIN=panel.tu-dominio.com
